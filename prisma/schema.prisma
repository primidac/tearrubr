generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             String   @id @default(uuid())
  manufacturer   String
  name           String
  description    String?
  blockchainTxHash String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
