# TearRubr Environment Variables
# Copy this file to .env and fill in your values

# Ethereum Sepolia RPC URL (e.g. from Alchemy or Infura)
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Private key of the deployer / signing wallet (must be funded with Sepolia ETH)
PRIVATE_KEY=your_private_key_here

# Deployed TearRubr smart contract address on Sepolia
CONTRACT_ADDRESS=0xa34C7D37BB2bf41f73e562075878E86eFc7Ed05B

# The Graph Studio subgraph URL for decentralized indexing
PUBLIC_SUBGRAPH_URL=https://api.studio.thegraph.com/query/YOUR_STUDIO_ID/tearrubr-sepolia/v0.0.1

# Privy passwordless authentication (optional)
PUBLIC_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret
